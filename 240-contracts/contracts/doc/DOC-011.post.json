{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:whiteboard:contracts:doc:DOC-011:post:2",
  "title": "Postcondition contract: DOC-011",
  "$comment": "Concrete postcondition for DOC-011. Validates canonical persisted diagram state shape after command execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "revision",
    "document",
    "editor_state"
  ],
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "kind",
        "label",
        "x",
        "y",
        "width",
        "height",
        "locked",
        "parent",
        "tags",
        "metadata",
        "z_index"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "node",
            "subgraph",
            "text"
          ]
        },
        "label": {
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        },
        "fontSize": {
          "type": [
            "number",
            "null"
          ]
        },
        "font_weight": {
          "type": [
            "string",
            "null"
          ]
        },
        "locked": {
          "type": "boolean"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "dag_rank": {
          "type": [
            "integer",
            "null"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "object"
        },
        "z_index": {
          "type": "integer"
        },
        "style": {
          "type": [
            "string",
            "null"
          ]
        },
        "collapsed": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "source",
        "target",
        "label",
        "style",
        "arrowType",
        "label_offset_t",
        "thickness",
        "directed",
        "bend_points",
        "tags",
        "metadata"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "style": {
          "type": "string"
        },
        "arrowType": {
          "type": "string"
        },
        "label_offset_t": {
          "type": "number"
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "thickness": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "directed": {
          "type": "boolean"
        },
        "bend_points": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "object"
        },
        "fontSize": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "editor_state": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "camera_x",
        "camera_y",
        "zoom",
        "grid_size",
        "snap_to_grid",
        "selected_items",
        "theme",
        "show_grid",
        "minimap_visible"
      ],
      "properties": {
        "camera_x": {
          "type": "number"
        },
        "camera_y": {
          "type": "number"
        },
        "zoom": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "grid_size": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "snap_to_grid": {
          "type": "boolean"
        },
        "selected_items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "editing_edge_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "theme": {
          "type": "string"
        },
        "show_grid": {
          "type": "boolean"
        },
        "minimap_visible": {
          "type": "boolean"
        }
      }
    }
  },
  "properties": {
    "version": {
      "const": 2
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "edges"
      ],
      "properties": {
        "nodes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/edge"
          }
        }
      }
    },
    "editor_state": {
      "$ref": "#/$defs/editor_state"
    }
  }
}
