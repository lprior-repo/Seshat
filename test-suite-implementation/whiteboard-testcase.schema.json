{
  "$defs": {
    "action": {
      "oneOf": [
        {
          "$ref": "#/$defs/opAction"
        },
        {
          "$ref": "#/$defs/pointerAction"
        },
        {
          "$ref": "#/$defs/keyboardAction"
        },
        {
          "$ref": "#/$defs/wheelAction"
        },
        {
          "$ref": "#/$defs/waitAction"
        }
      ]
    },
    "contractClause": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "jsonSchema"
              }
            }
          },
          "then": {
            "properties": {
              "expr": false
            },
            "required": [
              "schemaRef"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "kirkExpr"
              }
            }
          },
          "then": {
            "properties": {
              "schema": false,
              "schemaRef": false
            },
            "required": [
              "expr"
            ]
          }
        }
      ],
      "properties": {
        "expr": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,80}$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "jsonSchema",
            "kirkExpr"
          ],
          "type": "string"
        },
        "message": {
          "maxLength": 500,
          "type": "string"
        },
        "schema": {
          "type": "object"
        },
        "schemaRef": {
          "pattern": "^contracts/[A-Za-z0-9_./\\-]+\\.json$",
          "type": "string"
        },
        "severity": {
          "enum": [
            "error",
            "warn"
          ],
          "type": "string"
        },
        "tolerance": {
          "maximum": 1000000.0,
          "minimum": 0,
          "type": "number"
        },
        "when": {
          "enum": [
            "pre",
            "post",
            "invariant"
          ],
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "when"
      ],
      "type": "object"
    },
    "contracts": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "enum": [
            "kirk"
          ],
          "type": "string"
        },
        "ensures": {
          "items": {
            "$ref": "#/$defs/contractClause"
          },
          "maxItems": 50,
          "minItems": 1,
          "type": "array"
        },
        "invariants": {
          "items": {
            "$ref": "#/$defs/contractClause"
          },
          "maxItems": 50,
          "minItems": 1,
          "type": "array"
        },
        "requires": {
          "items": {
            "$ref": "#/$defs/contractClause"
          },
          "maxItems": 50,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "engine",
        "requires",
        "ensures",
        "invariants"
      ],
      "type": "object"
    },
    "keyboardAction": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "enum": [
            "down",
            "up"
          ],
          "type": "string"
        },
        "key": {
          "maxLength": 40,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "const": "keyboard"
        },
        "modifiers": {
          "$ref": "#/$defs/modifiers"
        },
        "text": {
          "maxLength": 2000,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "event",
        "key"
      ],
      "type": "object"
    },
    "modifiers": {
      "additionalProperties": false,
      "properties": {
        "alt": {
          "type": "boolean"
        },
        "ctrl": {
          "type": "boolean"
        },
        "meta": {
          "type": "boolean"
        },
        "shift": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "opAction": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "additionalProperties": true,
          "type": "object"
        },
        "kind": {
          "const": "op"
        },
        "op": {
          "maxLength": 80,
          "minLength": 1,
          "type": "string"
        },
        "saveAs": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "op"
      ],
      "type": "object"
    },
    "oracle": {
      "additionalProperties": false,
      "properties": {
        "imageRef": {
          "pattern": "^goldens/[A-Za-z0-9_./\\-]+\\.(png|webp|jpg)$",
          "type": "string"
        },
        "maxDiffPixels": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "integer"
        },
        "maxDiffRatio": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "perfBudgetMs": {
          "maximum": 600000,
          "minimum": 0,
          "type": "integer"
        },
        "snapshotName": {
          "maxLength": 120,
          "type": "string"
        },
        "type": {
          "enum": [
            "none",
            "visual",
            "perf",
            "state"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "param": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "string"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "maxLength": 2000,
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "boolean"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "integer"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "maximum": 2147483647,
                "minimum": -2147483648,
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "number"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "maximum": 1000000000000.0,
                "minimum": -1000000000000.0,
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "degrees"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "maximum": 3600,
                "minimum": -3600,
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "ratio"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "maximum": 1000,
                "minimum": 0,
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "milliseconds"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "maximum": 600000,
                "minimum": 0,
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "id"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "point"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "additionalProperties": false,
                "properties": {
                  "space": {
                    "enum": [
                      "screen",
                      "world"
                    ],
                    "type": "string"
                  },
                  "x": {
                    "maximum": 1000000000000.0,
                    "minimum": -1000000000000.0,
                    "type": "number"
                  },
                  "y": {
                    "maximum": 1000000000000.0,
                    "minimum": -1000000000000.0,
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y",
                  "space"
                ],
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "rect"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "additionalProperties": false,
                "properties": {
                  "h": {
                    "maximum": 1000000000000.0,
                    "minimum": 0,
                    "type": "number"
                  },
                  "space": {
                    "enum": [
                      "screen",
                      "world"
                    ],
                    "type": "string"
                  },
                  "w": {
                    "maximum": 1000000000000.0,
                    "minimum": 0,
                    "type": "number"
                  },
                  "x": {
                    "maximum": 1000000000000.0,
                    "minimum": -1000000000000.0,
                    "type": "number"
                  },
                  "y": {
                    "maximum": 1000000000000.0,
                    "minimum": -1000000000000.0,
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y",
                  "w",
                  "h",
                  "space"
                ],
                "type": "object"
              }
            }
          }
        }
      ],
      "properties": {
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
          "type": "string"
        },
        "type": {
          "enum": [
            "string",
            "boolean",
            "integer",
            "number",
            "point",
            "rect",
            "id",
            "degrees",
            "ratio",
            "milliseconds"
          ],
          "type": "string"
        },
        "value": {}
      },
      "required": [
        "name",
        "type",
        "value"
      ],
      "type": "object"
    },
    "point": {
      "additionalProperties": false,
      "properties": {
        "space": {
          "enum": [
            "screen",
            "world"
          ],
          "type": "string"
        },
        "x": {
          "maximum": 1000000000000.0,
          "minimum": -1000000000000.0,
          "type": "number"
        },
        "y": {
          "maximum": 1000000000000.0,
          "minimum": -1000000000000.0,
          "type": "number"
        }
      },
      "required": [
        "space",
        "x",
        "y"
      ],
      "type": "object"
    },
    "pointerAction": {
      "additionalProperties": false,
      "properties": {
        "button": {
          "enum": [
            "left",
            "right",
            "middle"
          ],
          "type": "string"
        },
        "event": {
          "enum": [
            "down",
            "move",
            "up",
            "click",
            "dblclick",
            "contextmenu"
          ],
          "type": "string"
        },
        "kind": {
          "const": "pointer"
        },
        "modifiers": {
          "$ref": "#/$defs/modifiers"
        },
        "pointerType": {
          "enum": [
            "mouse",
            "touch",
            "pen"
          ],
          "type": "string"
        },
        "pos": {
          "$ref": "#/$defs/point"
        },
        "targetId": {
          "maxLength": 128,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "event",
        "pos"
      ],
      "type": "object"
    },
    "reference": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "issue",
            "discussion",
            "doc",
            "paper",
            "repo"
          ],
          "type": "string"
        },
        "note": {
          "maxLength": 500,
          "type": "string"
        },
        "ref": {
          "maxLength": 500,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "type": "object"
    },
    "waitAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "wait"
        },
        "ms": {
          "maximum": 600000,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "ms"
      ],
      "type": "object"
    },
    "wheelAction": {
      "additionalProperties": false,
      "properties": {
        "deltaX": {
          "maximum": 1000000.0,
          "minimum": -1000000.0,
          "type": "number"
        },
        "deltaY": {
          "maximum": 1000000.0,
          "minimum": -1000000.0,
          "type": "number"
        },
        "kind": {
          "const": "wheel"
        },
        "modifiers": {
          "$ref": "#/$defs/modifiers"
        },
        "pos": {
          "$ref": "#/$defs/point"
        }
      },
      "required": [
        "kind",
        "deltaX",
        "deltaY",
        "pos"
      ],
      "type": "object"
    }
  },
  "$id": "urn:whiteboard:testcase:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "level": {
            "const": "visual"
          }
        }
      },
      "then": {
        "properties": {
          "oracle": {
            "properties": {
              "type": {
                "const": "visual"
              }
            },
            "required": [
              "type",
              "imageRef"
            ]
          }
        },
        "required": [
          "oracle",
          "actions"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "level": {
            "const": "performance"
          }
        }
      },
      "then": {
        "properties": {
          "oracle": {
            "properties": {
              "type": {
                "const": "perf"
              }
            },
            "required": [
              "type",
              "perfBudgetMs"
            ]
          }
        },
        "required": [
          "oracle"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "level": {
            "enum": [
              "integration",
              "e2e",
              "visual",
              "performance"
            ]
          }
        }
      },
      "then": {
        "required": [
          "actions"
        ]
      }
    }
  ],
  "description": "Strict schema for a single JSONL line representing one whiteboarding test case with design-by-contract clauses (pre/post/invariants) using Kirk checks and/or JSON Schema clauses.",
  "properties": {
    "actions": {
      "items": {
        "$ref": "#/$defs/action"
      },
      "maxItems": 2000,
      "type": "array"
    },
    "area": {
      "enum": [
        "doc",
        "geometry",
        "selection",
        "multiTransform",
        "subgraph",
        "edge",
        "camera",
        "snapping",
        "clipboard",
        "history",
        "io",
        "collab",
        "input",
        "performance"
      ],
      "type": "string"
    },
    "contracts": {
      "$ref": "#/$defs/contracts"
    },
    "description": {
      "maxLength": 2000,
      "minLength": 0,
      "type": "string"
    },
    "fixtureRef": {
      "pattern": "^fx/[a-z0-9][a-z0-9._/\\-]{0,120}$",
      "type": "string"
    },
    "id": {
      "pattern": "^[A-Z]{2,4}-\\d{3}$",
      "type": "string"
    },
    "level": {
      "enum": [
        "unit",
        "integration",
        "e2e",
        "visual",
        "fuzz",
        "performance"
      ],
      "type": "string"
    },
    "oracle": {
      "$ref": "#/$defs/oracle"
    },
    "params": {
      "items": {
        "$ref": "#/$defs/param"
      },
      "maxItems": 50,
      "type": "array"
    },
    "references": {
      "items": {
        "$ref": "#/$defs/reference"
      },
      "maxItems": 20,
      "type": "array"
    },
    "schemaVersion": {
      "const": "whiteboard-testcase@1",
      "type": "string"
    },
    "tags": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._:-]{1,40}$",
        "type": "string"
      },
      "maxItems": 30,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "title": {
      "maxLength": 200,
      "minLength": 3,
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "area",
    "level",
    "tags",
    "fixtureRef",
    "contracts"
  ],
  "title": "Whiteboard Test Case (DbC) - JSONL Entry",
  "type": "object"
}