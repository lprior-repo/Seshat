{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Seshat Diagram Document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "revision",
    "document",
    "editor_state"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 2,
      "maximum": 2
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "edges"
      ],
      "properties": {
        "nodes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/edge"
          }
        }
      }
    },
    "editor_state": {
      "$ref": "#/$defs/editor_state"
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "icon",
        "label",
        "x",
        "y",
        "width",
        "height",
        "locked",
        "tags",
        "metadata",
        "z_index"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["node", "subgraph", "text"]
        },
        "icon": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "font_size": {
          "type": ["number", "null"]
        },
        "font_weight": {
          "type": ["string", "null"],
          "enum": ["normal", "bold", null]
        },
        "locked": {
          "type": "boolean"
        },
        "parent": {
          "type": ["string", "null"]
        },
        "dag_rank": {
          "type": ["integer", "null"]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "object"
        },
        "z_index": {
          "type": "integer"
        },
        "style": {
          "type": ["string", "null"],
          "enum": ["box", "cloud", "cylinder", "dashed", null]
        },
        "collapsed": {
          "type": ["boolean", "null"]
        }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "target",
        "label",
        "style",
        "arrowhead",
        "label_offset_t",
        "thickness",
        "directed",
        "bend_points",
        "tags",
        "metadata"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "style": {
          "type": "string",
          "enum": ["solid", "dashed", "dotted"]
        },
        "arrowhead": {
          "type": "string",
          "enum": ["arrow", "open", "diamond", "circle", "none"]
        },
        "label_offset_t": {
          "type": "number"
        },
        "color": {
          "type": ["string", "null"]
        },
        "thickness": {
          "type": "number"
        },
        "directed": {
          "type": "boolean"
        },
        "bend_points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "object"
        },
        "font_size": {
          "type": ["number", "null"]
        }
      }
    },
    "editor_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "camera_x",
        "camera_y",
        "zoom",
        "grid_size",
        "snap_to_grid",
        "selected_items",
        "theme",
        "show_grid",
        "minimap_visible"
      ],
      "properties": {
        "camera_x": {
          "type": "number"
        },
        "camera_y": {
          "type": "number"
        },
        "zoom": {
          "type": "number"
        },
        "grid_size": {
          "type": "number"
        },
        "snap_to_grid": {
          "type": "boolean"
        },
        "selected_items": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "editing_edge_id": {
          "type": ["string", "null"]
        },
        "theme": {
          "type": "string",
          "enum": ["light", "dark", "system"]
        },
        "show_grid": {
          "type": "boolean"
        },
        "minimap_visible": {
          "type": "boolean"
        }
      }
    }
  }
}
