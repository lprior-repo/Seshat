{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Seshat Diagram Document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "revision",
    "document"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 2,
      "maximum": 2
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "edges"
      ],
      "properties": {
        "nodes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/edge"
          }
        }
      }
    },
    "editor_state": {
      "$ref": "#/$defs/editor_state"
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "label",
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["node", "subgraph", "text"]
        },
        "icon": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "fontSize": {
          "type": ["number", "null"]
        },
        "font_weight": {
          "type": ["string", "null"],
          "enum": ["normal", "bold", null]
        },
        "lock_state": {
          "type": "boolean"
        },
        "parent": {
          "type": ["string", "null"]
        },
        "dag_rank": {
          "type": ["integer", "null"]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "object"
        },
        "z_index": {
          "type": "integer"
        },
        "style": {
          "type": ["string", "null"],
          "enum": ["box", "cloud", "cylinder", "dashed", null]
        },
        "collapsed": {
          "type": ["boolean", "null"]
        }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "target"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "style": {
          "type": "string",
          "enum": ["solid", "dashed", "dotted"]
        },
        "arrowType": {
          "type": "string",
          "enum": ["default", "sharp", "curved", "step", "straight"]
        },
        "label_offset_t": {
          "type": "number"
        },
        "color": {
          "type": ["string", "null"]
        },
        "thickness": {
          "type": "number"
        },
        "directed": {
          "type": "boolean"
        },
        "bend_points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "object"
        },
        "fontSize": {
          "type": ["number", "null"]
        },
        "source_port": {
          "anyOf": [
            { "$ref": "#/$defs/port_anchor" },
            { "type": "null" }
          ]
        },
        "target_port": {
          "anyOf": [
            { "$ref": "#/$defs/port_anchor" },
            { "type": "null" }
          ]
        }
      }
    },
    "editor_state": {
      "type": "object",
      "required": [
        "camera_x",
        "camera_y",
        "zoom"
      ],
      "properties": {
        "camera_x": {
          "type": "number"
        },
        "camera_y": {
          "type": "number"
        },
        "zoom": {
          "type": "number"
        },
        "grid_size": {
          "type": "number"
        },
        "snap_to_grid": {
          "type": "boolean"
        },
        "selected_items": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "edit_mode_target": {
          "type": ["string", "null"]
        },
        "editing_edge_id": {
          "type": ["string", "null"]
        },
        "theme": {
          "type": "string",
          "enum": ["light", "dark", "system"]
        },
        "show_grid": {
          "type": "boolean"
        },
        "minimap_visible": {
          "type": "boolean"
        }
      }
    },
    "port_anchor": {
      "anyOf": [
        { "const": "top" },
        { "const": "bottom" },
        { "const": "left" },
        { "const": "right" },
        { "const": "center" },
        {
          "type": "object",
          "required": ["custom"],
          "properties": {
            "custom": {
              "$ref": "#/$defs/normalized_offset"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "normalized_offset": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    }
  }
}
